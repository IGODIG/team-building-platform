---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActivityCard from '../components/ActivityCard.astro';
import PackageCard from '../components/PackageCard.astro';
import { activities, packages, benefits } from '../data/content';
---
<BaseLayout title="Teamflow | Team building cu energie și sens" description="Activități de team building pentru echipe. Provocări, colaborare și experiențe create în jurul oamenilor." active="home">
  <section class="hero">
    <div class="hero-photo" role="img" aria-label="Echipă care petrece timp împreună în aer liber"></div>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <p class="eyebrow eyebrow-light"><span class="status-dot"></span> EXPERIENȚE PENTRU ECHIPE</p>
      <h1>O echipă bună.<br /><em>O experiență</em> care<br />o apropie.</h1>
      <p class="hero-copy">Mai puține slide-uri. Mai multă colaborare, energie și momente trăite împreună.</p>
      <div class="hero-actions"><a class="button button-lime" href={withBase("/solicita-oferta/")}>Hai să planificăm <span>↗</span></a><a class="hero-link" href={withBase("/activitati/")}>Explorează activitățile <span>↓</span></a></div>
      <div class="hero-foot"><span>01 / TEAM EXPERIENCES</span><span>OAMENI ÎNAINTE DE TOATE</span></div>
    </div>
    <div class="hero-side-note">COLABORARE · ENERGIE · ÎNCREDERE</div>
  </section>
  <section class="intro section-pad">
    <div class="container intro-grid"><p class="eyebrow">NU DOAR O IEȘIRE DIN BIROU</p><div><h2>Lucrurile se schimbă când <span>jucăm în aceeași echipă.</span></h2><p class="intro-copy">Construim experiențe în care oamenii comunică, găsesc soluții și se bucură de reușite împreună. Cu activități alese pentru echipa ta, nu dintr-un meniu universal.</p><a class="text-link" href={withBase("/cum-functioneaza/")}>Află cum lucrăm <span>→</span></a></div></div>
  </section>
  <section class="activities-section section-pad section-soft">
    <div class="container"><div class="section-heading"><div><p class="eyebrow">ALEGE EXPERIENȚA</p><h2>Mai multă acțiune.<br /><span>Mai puțină rutină.</span></h2></div><a class="text-link heading-link" href={withBase("/activitati/")}>Toate activitățile <span>→</span></a></div>
      <div class="activity-grid">{activities.slice(0,3).map((activity) => <ActivityCard activity={activity} />)}</div>
    </div>
  </section>
  <section class="benefits-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">DE CE TEAM BUILDING</p><h2>Distracție cu <span>un rost.</span></h2></div><p class="heading-description">Nu forțăm conexiunea cu exerciții stânjenitoare. Creăm contexte în care colaborarea apare natural.</p></div>
    <div class="benefit-grid">{benefits.map((benefit) => <article class="benefit-item"><span class="benefit-number">{benefit.number}</span><h3>{benefit.title}</h3><p>{benefit.text}</p></article>)}</div>
  </div></section>
  <section class="feature-band"><div class="feature-image"><img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1400&q=85" alt="Oameni care se bucură de o activitate de grup" loading="lazy" /></div><div class="feature-copy"><p class="eyebrow eyebrow-light">FIECARE ECHIPĂ E DIFERITĂ</p><h2>Programul potrivit începe cu <em>o conversație.</em></h2><p>Ne spui câți sunteți, ce vreți să obțineți și ce fel de experiență vi se potrivește. Construim de acolo.</p><a class="button button-lime" href={withBase("/configureaza-eveniment/")}>Începe configurarea <span>↗</span></a></div></section>
  <section class="packages-section section-pad"><div class="container"><div class="section-heading"><div><p class="eyebrow">PUNCT DE PORNIRE</p><h2>Pachete simple.<br /><span>Loc de personalizare.</span></h2></div><p class="heading-description">Prețurile afișate sunt orientative și demonstrative. Oferta reală depinde de grup, locație și format.</p></div><div class="package-grid">{packages.map((pack) => <PackageCard pack={pack} />)}</div></div></section>
  <section class="gallery-section section-pad section-soft"><div class="container"><div class="section-heading"><div><p class="eyebrow">MOMENTE ÎMPREUNĂ</p><h2>Mai puțin „trebuie”.<br /><span>Mai mult „îți amintești?”</span></h2></div><p class="heading-description">Fotografii de atmosferă pentru conceptul demonstrativ. În versiunea publică se vor înlocui cu imagini reale ale evenimentelor.</p></div><div class="gallery-grid"><img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1000&q=85" alt="Grup de prieteni în aer liber" loading="lazy" /><img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1000&q=85" alt="Echipă care colaborează" loading="lazy" /><img src="https://images.unsplash.com/photo-1528605248644-14dd04022da1?auto=format&fit=crop&w=1000&q=85" alt="Grup la o masă comună" loading="lazy" /></div></div></section>
  <section class="quote-section section-pad"><div class="container quote-inner"><p class="eyebrow">FILOSOFIA NOASTRĂ</p><span class="quote-mark" aria-hidden="true">“</span><blockquote>Un team building reușit nu înseamnă să câștige toată lumea. Înseamnă să plece cu toții mai aproape.</blockquote><p class="quote-author">Echipa Teamflow</p></div></section>
  <section class="final-cta"><div class="container final-cta-inner"><div><p class="eyebrow eyebrow-light">URMĂTORUL PAS</p><h2>Hai să facem loc<br />pentru <em>o experiență bună.</em></h2></div><a class="button button-lime" href={withBase("/solicita-oferta/")}>Cere o ofertă <span>↗</span></a></div></section>
</BaseLayout>
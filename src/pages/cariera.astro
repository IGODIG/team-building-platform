---
import { withBase } from '../utils/paths';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Carieră | Teamflow" description="Descoperă oportunități de colaborare cu Teamflow și trimite-ne CV-ul tău.">
  <section class="page-hero career-hero">
    <div class="container career-hero-grid">
      <div class="career-hero-copy">
        <p class="eyebrow">CARIERĂ</p>
        <h1>Hai să construim<br /><em>experiențe împreună.</em></h1>
        <p>Căutăm oameni care comunică bine, își asumă responsabilități și le place să aducă echipele împreună.</p>
        <div class="career-hero-actions">
          <a class="button button-dark" href="#career-application">Aplică spontan <span aria-hidden="true">↘</span></a>
          <a class="button button-outline" href={withBase("/contact/")}>Vorbește cu noi <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="career-hero-visual">
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=900&q=80" alt="Colegi care lucrează împreună la o masă" width="900" height="720" />
        <span class="career-hero-badge">Facilitatori · Coordonatori · Logistică</span>
      </div>
    </div>
  </section>
  <section class="section-pad section-soft career-opportunities">
    <div class="container">
      <div class="section-heading career-opportunities-heading">
        <div><p class="eyebrow">OPORTUNITĂȚI</p><h2>Locul potrivit<br /><span>poate fi al tău.</span></h2></div>
        <p class="heading-description">Publicăm aici pozițiile disponibile atunci când recrutăm. Până atunci, ne poți trimite CV-ul pentru oportunități viitoare.</p>
      </div>
      <article class="career-empty">
        <span class="career-empty-icon" aria-hidden="true">↗</span>
        <div><h3>Nu avem poziții deschise momentan</h3><p>Suntem bucuroși să aflăm despre tine și să te contactăm dacă apare o oportunitate potrivită.</p></div>
        <a class="text-link career-empty-link" href="#career-application">Trimite CV-ul <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>
  <section class="section-pad career-application-section" id="career-application">
    <div class="container career-layout">
      <div class="career-intro">
        <p class="eyebrow">APLICĂ SPONTAN</p>
        <h2>Trimite-ne<br /><span>CV-ul tău.</span></h2>
        <p class="body-large">Spune-ne câteva lucruri despre tine și atașează CV-ul. Poți aplica și fără o poziție anume.</p>
        <div class="aside-note"><span>01</span><p>Comunicare și respect pentru oameni</p></div>
        <div class="aside-note"><span>02</span><p>Responsabilitate și inițiativă</p></div>
        <div class="aside-note"><span>03</span><p>Dorința de a crea experiențe bune</p></div>
      </div>
      <form class="contact-form career-form" data-form>
        <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="form-row">
          <label>Nume și prenume<input name="name" autocomplete="name" required placeholder="Numele tău" /></label>
          <label>Email<input type="email" name="email" autocomplete="email" required placeholder="nume@email.com" /></label>
        </div>
        <div class="form-row">
          <label>Telefon<input type="tel" name="phone" autocomplete="tel" placeholder="+373 ..." /></label>
          <label>Poziția dorită<input name="position" placeholder="Ex. Facilitator de activități" /></label>
        </div>
        <label>Despre tine<textarea name="message" rows="4" placeholder="Experiență, abilități sau ce te atrage la Teamflow"></textarea></label>
        <label class="career-file-label">CV (PDF sau DOCX)
          <input type="file" name="cv" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
          <span class="career-file-help">Opțional. Poți aplica și fără CV.</span>
        </label>
        <label class="career-consent"><input type="checkbox" name="privacy" required /> <span>Confirm că am citit informațiile despre <a href={withBase("/confidentialitate/")}>confidențialitate</a>.</span></label>
        <button class="button button-dark career-submit" type="submit">Trimite candidatura <span aria-hidden="true">↗</span></button>
        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        <p class="form-legal">Folosim datele doar pentru a evalua candidatura ta.</p>
      </form>
    </div>
  </section>
</BaseLayout>

import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Carieră | Teamflow" description="O pagină demonstrativă pentru oportunități de colaborare.">
  <section class="page-hero"><div class="container"><p class="eyebrow">CARIERĂ</p><h1>Îți place să aduni<br /><em>oamenii împreună?</em></h1><p>Ne interesează oamenii energici, responsabili și atenți la grup. În acest moment, pagina este demonstrativă și nu afișează posturi reale.</p><a class="button button-dark" href="/contact/">Contact pentru colaborare <span>↗</span></a></div></section>
  <section class="section-pad"><div class="container detail-columns"><div><p class="eyebrow">CE CONTEAZĂ</p><h2>Atitudine bună.<br /><span>Organizare și grijă.</span></h2></div><div><p class="body-large">Un facilitator bun știe să asculte, să explice clar și să creeze un spațiu în care fiecare poate participa. Experiența este importantă, dar nu înlocuiește respectul pentru oameni.</p></div></div></section>
</BaseLayout>
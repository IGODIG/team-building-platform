---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityCard from '../../components/ActivityCard.astro';
import { activities, activityCategories } from '../../data/content';
---
<BaseLayout title="Activități de team building | Teamflow" description="Explorează activități de team building pentru echipe mici și mari." active="activities">
  <section class="page-hero"><div class="container"><p class="eyebrow">ACTIVITĂȚI</p><h1>Găsește formatul<br /><em>echipei tale.</em></h1><p>De la competiții energice la exerciții de colaborare. Alege direcția și adaptăm detaliile împreună.</p></div></section>
  <section class="section-pad"><div class="container">
    <div class="filter-bar" role="group" aria-label="Filtrare activități" data-activity-filters><span class="eyebrow" aria-hidden="true">FILTRARE</span><button class="filter-button is-active" type="button" aria-pressed="true" data-filter="all">Toate</button>{activityCategories.map((category) => <button class="filter-button" type="button" aria-pressed="false" data-filter={category}>{category}</button>)}</div>
    <h2 class="sr-only">Toate activitățile</h2><div class="activity-grid catalog-grid">{activities.map((activity) => <div data-activity-card data-category={activity.category}><ActivityCard activity={activity} /></div>)}</div>
    <p class="empty-state" data-empty-state role="status" hidden>Nu am găsit activități în această categorie.</p>
    <p class="sr-only" data-filter-status role="status" aria-live="polite"></p>
  </div></section>
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('[data-activity-card]');
    const empty = document.querySelector<HTMLElement>('[data-empty-state]');
    const announce = document.querySelector<HTMLElement>('[data-filter-status]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => {
        item.classList.toggle('is-active', item === button);
        item.setAttribute('aria-pressed', String(item === button));
      });
      let visible = 0;
      cards.forEach((card) => {
        const show = button.dataset.filter === 'all' || card.dataset.category === button.dataset.filter;
        card.hidden = !show;
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
      if (announce) announce.textContent = `${visible} activități afișate.`;
    }));
  </script>
</BaseLayout>

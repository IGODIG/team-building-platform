---
const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'Acasă', key: 'home' },
  { href: '/activitati/', label: 'Activități', key: 'activities' },
  { href: '/pachete/', label: 'Pachete', key: 'packages' },
  { href: '/cum-functioneaza/', label: 'Cum funcționează', key: 'how' }
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Pagina principală"><span class="brand-mark">t<span>.</span></span><span class="brand-name">team<span>flow</span></span></a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-label="Deschide meniul"><span></span><span></span></button>
    <nav class="main-nav" data-menu aria-label="Navigare principală">
      {links.map((link) => <a href={link.href} class:list={{ active: active === link.key }}>{link.label}</a>)}
      <a class="button button-dark nav-cta" href="/solicita-oferta/">Cere o ofertă <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>